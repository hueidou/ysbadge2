# ---- Python 运行时产物 ----
__pycache__/
*.pyc

# ---- _verify 实验图片：fixture 与输出，由 gen_*.py / check_*.py 再生 ----
_verify/*.png
!_verify/test_pattern.png
!_verify/marker.png
_verify/*.jpg

# ---- browser_check.js 的 headless 浏览器 profile（可再生） ----
_verify/_browser_profile/
_verify/_bp*/

# ---- 临时脚本/提交信息 ----
_verify/_commit_msg.txt
_verify/_build*.py
_verify/_edit_*
_verify/_fix_*
_verify/_patch_*
_verify/_probe*

# ---- ESP32 工具链（本机 arduino-cli / mingw，不入库） ----
.toolchain/
firmware/*/build/
firmware/*/*.bin
firmware/*/*.elf

# ---- 本机凭据（WiFi 密码等） ----
firmware/weather_badge/secrets.h

# ---- 本机验证产物 ----
_verify/host/*.exe
_verify/host/*.ppm
_verify/host/*.png
_verify/host/*.lz
_verify/host/*.raw
_verify/host/_frame.inc
_verify/_c3_bootlog.bin
*_probe*.bin

# ---- 图片/版式实验产物（AI 出图、抖动对比图，本地留存不入库） ----
_art/

# ---- 其他 ----
*.log
Thumbs.db
desktop.ini
.DS_Store

